OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_REASONING_EFFORT=medium
BRAIN_PROVIDER=fake
# JEV is the default action selector. It chooses one bounded intent per loop
# until the mission is done. JEV_ENABLED=false keeps the one-shot planner path.
JEV_ENABLED=true
JEV_MODEL=typesafe/jev-1.13
# Live calls use the first configured key. Neither key is written to logs.
# OPENROUTER_API_KEY calls typesafe/jev-1.13 at /api/alpha/decisions.
# TYPESAFE_API_KEY calls https://api.typesafe.ai/v1/systemone.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
BODY_BACKEND=mock
API_HOST=0.0.0.0
API_PORT=8000
SIMULATION_BACKEND=mock
TELEMETRY_OUTPUT_JSONL=
# SESSION_RECORDING=true records camera frames + telemetry to RECORDINGS_ROOT/<session_id>/.
SESSION_RECORDING=false
RECORDINGS_ROOT=artifacts/recordings
RECORDING_FRAME_INTERVAL_S=0.5
SIMULATION_SEED=42
ALLOW_GROUND_TRUTH_FOR_TESTS=false
TEST_GROUND_TRUTH=false
RENDER_OPERATOR_CAMERA=true
# RECORD_IMAGES_BY_DEFAULT=true forces recording for every mission step.
RECORD_IMAGES_BY_DEFAULT=false
INTENT_TTL_MS=1500
PERCEPTION_INTERVAL_S=0.5
MAX_SPEED_NORMALISED=0.65
MAX_TURN_NORMALISED=0.75
CONTACT_FORCE_LIMIT=0.35
